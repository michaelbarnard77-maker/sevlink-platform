@echo off
title Update Sevlink
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "& { $ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue'; [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; try { Write-Host 'SEVLINK UPDATE' -ForegroundColor Cyan; Write-Host 'Keep your website server stopped while this update runs.'; Write-Host 'Checking the latest approved update...'; $manifest=Invoke-RestMethod -Uri 'https://raw.githubusercontent.com/michaelbarnard77-maker/sevlink-platform/development/phase-1-foundations/scripts/windows-update.json' -TimeoutSec 60; if ($manifest.sha256 -notmatch '^[a-f0-9]{64}$' -or $manifest.version -notmatch '^[a-f0-9]{7,40}$' -or $manifest.url -notmatch '^https://raw\.githubusercontent\.com/michaelbarnard77-maker/sevlink-platform/[a-f0-9]{7,40}/scripts/update-windows-[a-z0-9-]+\.ps1$') { throw 'Invalid update information. Nothing installed.' }; $folder=Join-Path $env:LOCALAPPDATA ('Sevlink\Updates\'+[Guid]::NewGuid().ToString('N')); New-Item -ItemType Directory -Path $folder | Out-Null; $file=Join-Path $folder 'install.ps1'; Write-Host ('Downloading update '+$manifest.version+'...'); Invoke-WebRequest -UseBasicParsing -Uri $manifest.url -OutFile $file -TimeoutSec 180; if ((Get-FileHash -LiteralPath $file -Algorithm SHA256).Hash.ToLowerInvariant() -ne $manifest.sha256) { Remove-Item -LiteralPath $file; throw 'Download check failed. Nothing installed. Try again.' }; Write-Host 'Download verified. Installing...'; & $file; Write-Host ''; Write-Host 'Restart your website server, then open http://127.0.0.1:8000/'; exit 0 } catch { Write-Host ''; Write-Host ('UPDATE STOPPED: '+$_.Exception.Message) -ForegroundColor Red; Write-Host 'Take a screenshot of this window if you need help.'; exit 1 } }"
set "sevlinkUpdateResult=%ERRORLEVEL%"
echo.
pause
exit /b %sevlinkUpdateResult%
