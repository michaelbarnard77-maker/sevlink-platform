# Copy to .env ONLY on the controlled deployment host. Never commit actual secrets.
DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
PORTAL_HOST=portal.sevlink.co.za
SITE_URL=https://portal.sevlink.co.za
ALLOWED_HOSTS=portal.sevlink.co.za
CERT_EMAIL=YOUR_ADMIN_EMAIL
DB_PASSWORD=REPLACE_WITH_A_NEW_RANDOM_DATABASE_PASSWORD
DB_HOST=db
DB_NAME=sevlink
DB_USER=sevlink
# Mail delivery is deliberately disabled. Use the SMTP details supplied by
# your email host; enable TLS or SSL according to their instructions, not both.
SMTP_DELIVERY_ENABLED=0
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Sevlink <maintenance@sevlink.co.za>

# Saved job events always create outbox entries. Default delivery is local previews only.
OPERATIONS_NOTIFICATION_EMAIL=maintenance@sevlink.co.za
OPERATIONS_EMAIL_DELIVERY_BACKEND=portal.mail.PrivatePreviewBackend
OPERATIONS_LIVE_DELIVERY_ENABLED=0

# Mounted secrets supported: choose ENV value OR ENV_FILE, not both.
# DJANGO_SECRET_KEY_FILE=/run/secrets/django_secret_key
# DB_PASSWORD_FILE=/run/secrets/db_password
# EMAIL_HOST_USER_FILE=/run/secrets/smtp_user
# EMAIL_HOST_PASSWORD_FILE=/run/secrets/smtp_password
# For a real PostgreSQL endpoint, require identity-verified TLS and a trusted CA.
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/run/secrets/postgres_ca_bundle
# SES SMTP correlation tags are opt-in; no delivery is enabled by this setting.
OPERATIONS_SES_TAGGING_ENABLED=0
# OPERATIONS_PREVIEW_DIR=/var/lib/sevlink/private-email-preview
