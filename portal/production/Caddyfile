    email {$CERT_EMAIL}
}
{$PORTAL_HOST} {
    encode zstd gzip
    handle_path /static/* {
        root * /srv/static
        file_server
    }
    handle {
        reverse_proxy web:8000
    }
    header {
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        -Server
    }
}
